# Environments
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Data — never commit. The ImageNet zip alone is 11.3 GB.
# NOTE: this must stay anchored with a leading slash. A bare "data/" matches a
# directory of that name at ANY depth, which silently excluded the *source*
# package eps/data/ from every commit from 2026-08-07 until 2026-08-11 — the
# public repo had no dataset loaders and no imagenet_classes.txt, so a fresh
# clone could not train, sample, evaluate, or serve the demo. See CLAUDE.md 10.17.
/data/
eps/data/imagenet64/
*.zip
*.npz
*.u8

# Training artifacts
runs/
logs/
wandb/
*.pt
*.ckpt
samples*.png

# Large files that happen to live in this directory
*.dmg

# OS / editor
.DS_Store
.idea/
.vscode/

# Build artifacts
*.egg-info/
